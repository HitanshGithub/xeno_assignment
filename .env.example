# ---------------------------------------------------------------------------
# Cadence — environment configuration
# Copy to `.env` (root) for local docker-compose, or set per-service in prod.
# Every service reads from process.env; nothing here is required to *boot*.
# ---------------------------------------------------------------------------

# --- Database (Postgres) ----------------------------------------------------
# Local docker-compose provides this automatically. For production use a
# pooled Neon connection string (…-pooler.…neon.tech).
DATABASE_URL="postgresql://cadence:cadence@localhost:5432/cadence?schema=public"

# --- AI provider ------------------------------------------------------------
# AI_PROVIDER: "anthropic" | "mock" | "auto" (auto = anthropic if a key is
# present, otherwise the deterministic mock so the app always runs for free).
AI_PROVIDER="auto"
ANTHROPIC_API_KEY=""
AI_MODEL_REASONING="claude-sonnet-4-6"
AI_MODEL_DRAFT="claude-haiku-4-5-20251001"

# --- Service-to-service wiring ----------------------------------------------
# The CRM calls the channel service's /v1/send; the channel service calls back
# into the CRM's /api/receipts. In prod these are the two public URLs.
CHANNEL_SERVICE_URL="http://localhost:4000"
CRM_BASE_URL="http://localhost:3000"

# Shared secrets that authenticate the two hops (HMAC-signed callbacks +
# bearer on send). Generate with: openssl rand -hex 32
CHANNEL_SERVICE_API_KEY="dev-send-key-change-me"
CHANNEL_CALLBACK_SECRET="dev-callback-secret-change-me"

# --- Channel simulator tuning (optional; sensible defaults baked in) --------
CHANNEL_PORT="4000"
# Multiplier on simulated latency (1 = realistic, 0.05 = fast demo mode).
CHANNEL_SPEED="0.15"
